# Mailcow configuration — copy to mailcow.conf and customise.
#
# This is NOT the full config. The full mailcow.conf is ~300 lines and is
# generated by mailcow's generate_config.sh. This file documents only the
# settings you MUST change for this deployment.
#
# Generate the full config:
#   cd /opt/mailcow-dockerized && ./generate_config.sh
#
# Then edit mailcow.conf and set these values:

# --- Required changes -------------------------------------------------------
MAILCOW_HOSTNAME=mail.yaseen.pk
TZ=Asia/Karachi

# --- Optional tuning --------------------------------------------------------
# Set to 'y' to save ~1 GB RAM if you don't need on-access virus scanning.
# ClamAV is mainly useful for inbound mail from external senders.
SKIP_CLAMD=n

# Set to 'y' to save ~500 MB RAM. Full-text search is only needed if users
# search their mailbox via SOGo or IMAP.
SKIP_SOLR=y

# --- Ports ------------------------------------------------------------------
# 80/443 belong to Coolify's Traefik. Do NOT bind them here — Traefik handles
# TLS termination for the admin UI and SOGo webmail.
HTTP_PORT=80
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
HTTPS_BIND=0.0.0.0

# --- Database ---------------------------------------------------------------
# Generated by generate_config.sh. Do not change unless you know what you're
# doing. Mailcow manages its own MariaDB.
MAILCOW_DBPASS=changeme
MAILCOW_DBNAME=mailcow
