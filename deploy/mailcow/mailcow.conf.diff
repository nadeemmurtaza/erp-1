# Settings to change in mailcow.conf after running generate_config.sh.
#
# mailcow.conf is generated on the server and holds secrets, so it is not kept
# in this repository. This file records only the values that must differ from
# mailcow's defaults for our setup, and why — apply them by hand and keep the
# rest of the generated file as it came.
#
#   cd /opt/mailcow-dockerized
#   ./generate_config.sh          # asks for the hostname: mail.yaseen.pk
#   nano mailcow.conf             # apply the settings below
#   cp ~/apps/yaseenecom/deploy/mailcow/docker-compose.override.yml .
#   docker compose up -d

# --- Reverse proxy ---------------------------------------------------------
# Caddy owns 80 and 443. mailcow's nginx must not try to take them, and its
# ACME client cannot complete a challenge without them, so Caddy handles the
# certificate and deploy/mailcow/sync-certs.sh hands it to Postfix/Dovecot.
#
# The bind addresses are loopback so nothing is published to the internet;
# Caddy reaches nginx-mailcow over the shared yaseen-edge network instead.
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
HTTPS_PORT=8443
HTTPS_BIND=127.0.0.1
SKIP_LETS_ENCRYPT=y

# --- Memory ----------------------------------------------------------------
# ClamAV is 2-3 GB on its own and the store's prod and staging stacks already
# claim about 4.5 GB of the 12 GB on this box. Off, mailcow sits near 2.5 GB.
# Rspamd still filters spam; what is given up is attachment virus scanning.
SKIP_CLAMD=y

# Solr full-text search only makes mailbox search faster. A support inbox does
# not need it, and it is another 1 GB.
SKIP_SOLR=y

# --- Mail ------------------------------------------------------------------
# The name Postfix gives in HELO and the name on the certificate. The PTR
# record for this server's IP has to match it exactly, or receivers reject us.
MAILCOW_HOSTNAME=mail.yaseen.pk

# The store sends through SMTP AUTH on 587 like any other client, so plain
# submission stays available on the public interface. Keep 25 open too: that
# is how the rest of the internet delivers mail *to* us.
