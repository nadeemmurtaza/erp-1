// The cross-tenant marketplace/product-reference network — doc 165
// (165-cross-tenant-marketplace-directory.md) and doc 166
// (166-unified-product-reference-registry.md). Lives in this app's own
// control-plane database, never a tenant's, per
// 39-shared-cross-tenant-hosting-tier.md's "shared compute, never shared
// data" rule: what these tables hold is data a tenant explicitly chose to
// publish/share, categorically different from the private business data
// doc 39 protects.
//
// Doc 165's own publish layer (MarketplaceListing) is built and live —
// WO-165.2's publish API (product-reference.module.ts's own
// MarketplaceListingsController) reads and writes it, gated by the same
// MarketplacePublisherCredential this file already shipped for doc 166.
//
// MarketplaceViewerProfile/MarketplaceEngagement are schema only, matching
// this file's own bundled WO-165.1 ("MarketplaceListing,
// MarketplacePublisherCredential, MarketplaceViewerProfile,
// MarketplaceEngagement... one forward-only migration"): no service or
// controller reads or writes either table yet. Doc 165 §4 names why,
// honestly, rather than half-building around it — discovery (WO-165.3) and
// the transact path (WO-165.4) both need a viewer to be identified, and
// the only login doc 165 permits is nID's own OIDC, whose issuer surface
// `nadeemmurtaza/nID` (a separate repository not attached to any session
// that has built this) has never confirmed exists. These two tables are
// shaped now, per doc 18.5's own "shape it so a real request isn't a
// design exercise" precedent, so the day that blocker clears, WO-165.3/
// 165.4 are pure service/controller work against an already-reviewed
// schema — never a second migration to re-derive the shape.

/// One row per tenant that has opted into the cross-tenant network (either
/// capability this file offers). Same "hash-only, shown once" discipline
/// as every other credential in this codebase — see
/// `agency-key.ts`/`AgencyApiKeyGuard` for the identical shape this
/// mirrors, with its own, separate pepper (`PLATFORM_MARKETPLACE_KEY_PEPPER`)
/// since this is a different credential type with a different blast
/// radius than the agency-managed-services key.
model MarketplacePublisherCredential {
  id         String    @id @default(cuid())
  tenantId   String    @unique
  apiKeyHash String    @unique
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant PlatformTenant @relation(fields: [tenantId], references: [id])
}

enum ProductReferenceReviewStatus {
  UNREVIEWED
  CONFIRMED
  FLAGGED
}

/// One row per physical product, keyed by the one fact that is
/// unambiguously true regardless of who is selling it: its barcode. The
/// registering tenant is recorded for provenance and moderation authority
/// (see GlobalProductReferenceFlag), never for runtime ownership of every
/// future read — any tenant holding a MarketplacePublisherCredential may
/// look one up.
model GlobalProductReference {
  id                   String                       @id @default(cuid())
  /// The GTIN/UPC/EAN off the box. The one join key every participant in
  /// the chain already has, since it is already printed on the physical
  /// product — no new identifier scheme invented.
  barcode              String                       @unique
  registeredByTenantId String
  reviewStatus         ProductReferenceReviewStatus @default(UNREVIEWED)
  /// Every other descriptive "small detail" beyond name/description/care
  /// instructions/images — fabric, season, dimensions, weight, safety
  /// notes, whatever a sector pack cares about. A plain JSON bag, not a
  /// hardcoded column per attribute: MULTI-SECTOR.md's own "sector =
  /// configuration" rule means an apparel pack's keys (fabric, fit) and a
  /// grocery pack's keys (expiryMonths, storageTemp) must never force a
  /// schema change on this universal, sector-agnostic table.
  attributes           Json                         @default("{}")
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  registeredByTenant PlatformTenant                      @relation(fields: [registeredByTenantId], references: [id])
  translations       GlobalProductReferenceTranslation[]
  images             GlobalProductReferenceImage[]
  links              GlobalProductReferenceLink[]
  flags              GlobalProductReferenceFlag[]

  @@index([registeredByTenantId])
}

/// Mirrors ProductTranslation's own locale-keyed shape exactly (en/ur) —
/// the identical structure a linked tenant's own table is synced into.
model GlobalProductReferenceTranslation {
  id               String  @id @default(cuid())
  referenceId      String
  locale           String
  name             String
  description      String?
  careInstructions String?

  reference GlobalProductReference @relation(fields: [referenceId], references: [id])

  @@unique([referenceId, locale])
}

/// The shared image itself, stored once in the platform app's own storage
/// driver — never copied into a linking tenant's bucket for a
/// cloud-connected tenant (an offline-capable deployment's own local
/// snapshot is the one place this document's own bytes ARE duplicated,
/// deliberately — see doc 166's own "Where the real storage cost is").
/// altText is mandatory, unchanged from doc 03's own enforced-alt-text gate.
model GlobalProductReferenceImage {
  id          String @id @default(cuid())
  referenceId String
  url         String
  altText     String
  order       Int    @default(0)

  reference GlobalProductReference @relation(fields: [referenceId], references: [id])

  @@index([referenceId])
}

/// One row per tenant that has linked one of their own ProductVariants to
/// this shared reference. This is the join the push sync fan-out and the
/// pull/export endpoint both walk — never a live read path a storefront
/// touches per request.
model GlobalProductReferenceLink {
  id          String   @id @default(cuid())
  referenceId String
  tenantId    String
  /// The tenant's own ProductVariant.id — opaque here, exactly as
  /// MarketplaceListing.externalRef is opaque in doc 165.
  variantRef  String
  linkedAt    DateTime @default(now())

  reference GlobalProductReference @relation(fields: [referenceId], references: [id])
  tenant    PlatformTenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, variantRef])
  @@index([referenceId])
  @@index([tenantId])
}

/// A non-owning tenant's report that a shared reference is wrong —
/// reviewed by platform staff, never auto-applied. This is the toxic-pair
/// guard: without it, any tenant could silently rewrite another's
/// canonical record by editing "their own" reference.
model GlobalProductReferenceFlag {
  id                String    @id @default(cuid())
  referenceId       String
  flaggedByTenantId String
  reason            String
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  reference       GlobalProductReference @relation(fields: [referenceId], references: [id])
  flaggedByTenant PlatformTenant         @relation(fields: [flaggedByTenantId], references: [id])

  @@index([referenceId])
}

// --- Doc 165's own publish/discover/transact layer -------------------------

enum MarketplaceListingKind {
  PRODUCT
  SERVICE
}

/// Exactly the four categories the owner named. A viewer who is none of
/// these sees only listings with DIRECT_CUSTOMER in their visibleTo set, or
/// nothing (WO-165.3, not yet built — see this file's own header note).
enum MarketplaceAudience {
  RETAILER
  DISTRIBUTOR
  SUPPLIER
  DIRECT_CUSTOMER
}

enum MarketplaceListingStatus {
  ACTIVE
  PAUSED
  DELISTED
}

/// The owner's own answer: "give both discovery and transaction and let the
/// client choose" — a per-listing choice, never a platform-wide one.
enum MarketplaceEngagementMode {
  DISCOVERY_ONLY
  DISCOVERY_AND_TRANSACT
}

/// A tenant's own published product/service, WO-165.2. Every write goes
/// through MarketplaceListingsService, gated by MarketplaceCredentialGuard —
/// "which tenant" is always the presented key, never a body/query parameter.
model MarketplaceListing {
  id              String                     @id @default(cuid())
  tenantId        String
  kind            MarketplaceListingKind
  /// The tenant's own ProductVariant/Service id — opaque here, never
  /// resolved or dereferenced by the directory, only echoed back to the
  /// tenant on an engagement (doc 165 §2), the same decoupling
  /// GlobalProductReferenceLink.variantRef already uses in this same file.
  externalRef     String
  title           String
  description     String
  priceMinorUnits Int?
  currency        String?
  imageUrl        String?
  visibleTo       MarketplaceAudience[]
  engagementMode  MarketplaceEngagementMode  @default(DISCOVERY_ONLY)
  status          MarketplaceListingStatus   @default(ACTIVE)
  publishedAt     DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  tenant      PlatformTenant          @relation(fields: [tenantId], references: [id])
  engagements MarketplaceEngagement[]

  @@unique([tenantId, externalRef])
  @@index([status, kind])
}

/// A viewer authenticated once via nID and reused across every tenant's
/// published listings — a fourth kind of principal (doc 165's own "actor
/// with three tables" lens): not a User (no tenant relationship), not a
/// Party/Contact (no tenant owns them), not a TradingPartner (not
/// pre-registered). Schema only until WO-165.3/165.4 unblock — see this
/// file's own header note.
model MarketplaceViewerProfile {
  id           String               @id @default(cuid())
  /// Ties to nID's own subject, the identical join key
  /// IdentityVerification.nidSubjectId already uses on the erp-1 side.
  nidSubjectId String               @unique
  /// Phase 1: self-declared at first login, shown back as "you told us
  /// you're a distributor" — never presented as verified.
  declaredType MarketplaceAudience
  /// Phase 2 (doc 165 §5, explicitly deferred): set only once nID's own KYB
  /// confirms the organization's declared type. Null until nID ships KYB.
  verifiedType MarketplaceAudience?
  createdAt    DateTime             @default(now())

  engagements MarketplaceEngagement[]
}

enum MarketplaceEngagementKind {
  INQUIRY
  ORDER_REQUEST
}

enum MarketplaceEngagementStatus {
  PENDING
  DELIVERED
  FAILED
}

/// A viewer acting on a listing, chosen by the listing's own
/// engagementMode. Schema only until WO-165.3/165.4 unblock — see this
/// file's own header note.
model MarketplaceEngagement {
  id              String                      @id @default(cuid())
  listingId       String
  viewerProfileId String
  kind            MarketplaceEngagementKind
  payload         Json
  status          MarketplaceEngagementStatus @default(PENDING)
  deliveryError   String?
  createdAt       DateTime                    @default(now())
  deliveredAt     DateTime?

  listing       MarketplaceListing       @relation(fields: [listingId], references: [id])
  viewerProfile MarketplaceViewerProfile @relation(fields: [viewerProfileId], references: [id])

  @@index([listingId, status])
}
