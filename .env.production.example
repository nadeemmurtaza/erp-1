# ---------------------------------------------------------------------------
# Production secrets for docker-compose.prod.yml.
#
# On the VPS: cp .env.production.example .env.production, then fill in every
# value below for real. This file is used TWO ways by docker compose:
#   1. `--env-file .env.production` — interpolates ${POSTGRES_PASSWORD} etc.
#      into docker-compose.prod.yml itself.
#   2. `env_file: .env.production` (per service) — injected into the api/web
#      containers' environment directly.
# Never commit .env.production. DATABASE_URL is NOT listed here —
# docker-compose.prod.yml builds it itself from the Postgres vars below and the
# `postgres` service name, so the containers always point at each other
# correctly regardless of what you set here.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database (used to build DATABASE_URL — see docker-compose.prod.yml) --
POSTGRES_USER=yaseen
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-base64-32
POSTGRES_DB=yaseen

# --- API --------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS="https://yaseen.pk,https://www.yaseen.pk"

# --- Auth ---------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE-ME"
JWT_REFRESH_SECRET="CHANGE-ME"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Exactly 32 bytes. Generate with: openssl rand -base64 24 | head -c 32
APP_ENCRYPTION_KEY="CHANGE-ME-32-BYTES-EXACTLY-PLZ!!"

# --- Topology (RETAIL-ERP.md) ---------------------------------------------
# STANDALONE = this deployment today: one node, no replication, every chain
# concept invisible. BRANCH and BRAND replicate to PARENT_URL; ORG has none.
# See docker-compose.branch.yml + .env.branch.example for an actual BRANCH box.
NODE_ROLE=STANDALONE
NODE_ID=main
# PARENT_URL=https://brand1.example
# PARENT_API_KEY=                # issued by the parent — see .env.branch.example

# --- Module registry ------------------------------------------------------
# Available: catalog,measurements,cart,stitching,inventory,purchasing,production,parties,tradingpartners,payments,orders,crm,marketing,analytics,reports,tax,tracking,content,collections,search,onsitemessages,organization,accounting,identity-verification,pos,transfers,wallet
# Off by default everywhere, deliberately (modules.registry.ts marks each
# offByDefault) — a Solo shop must not see a chain or GL concept at all,
# RETAIL-ERP.md R14. Add one to MODULES only once the deployment really has
# branches, a general ledger, a physical till, or NID credentials:
#   organization, accounting, identity-verification, pos, transfers
MODULES="catalog,measurements,cart,orders,payments,stitching,inventory,purchasing,production,bom,parties,tradingpartners,crm,marketing,analytics,reports,tax,finance,fulfilment,payroll,tracking,promotions,giftcards,content,collections,search,onsitemessages,reviews,wishlist,loyalty,notification-preferences,recommendations"

# --- Payments -------------------------------------------------------------
PAYMENT_PROVIDERS="cod,bank_transfer"
COURIER_PROVIDERS="manual"

# JazzCash (leave blank until the merchant account is approved)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL="https://yaseen.pk/checkout/callback/jazzcash"
JAZZCASH_SANDBOX=false

# Easypaisa (leave blank until the merchant account is approved)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL="https://yaseen.pk/checkout/callback/easypaisa"
EASYPAISA_SANDBOX=false

# Giftkarta — third-party gift-card redemption at checkout (leave blank until
# a real API reference confirms these field names; see giftkarta.provider.ts)
GIFTKARTA_API_BASE_URL=
GIFTKARTA_API_KEY=

# nID identity verification (github.com/nadeemmurtaza/nID) — leave blank until
# this shop's tenant account and API key exist there. Also add
# 'identity-verification' to MODULES above once these are set.
NID_API_URL=
NID_API_KEY=
NID_WEBHOOK_SECRET=

# --- Storage ----------------------------------------------------------
# STORAGE_DRIVER=local keeps uploads on the VPS disk (the api-prod-uploads
# volume) — fine to start with, and deploy/backup.sh now ships that volume
# off-site alongside the database, so it is not a silent single point of
# failure. Switch to s3 + a real bucket/CDN once you have one; until then
# leave the S3_* vars blank.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
LOCAL_STORAGE_DIR="./uploads"
LOCAL_STORAGE_PUBLIC_URL="https://api.yaseen.pk/api/v1/files"

# --- Notifications ------------------------------------------------------
NOTIFICATION_CHANNELS="log"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Yaseen <no-reply@yaseen.pk>"

# WhatsApp / SMS (WO-8.4) — required if NOTIFICATION_CHANNELS includes them.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM_NUMBER=

# --- Seed admin (only used the first time the DB is seeded) ---------------
SEED_ADMIN_EMAIL="admin@yaseen.pk"
SEED_ADMIN_PASSWORD="CHANGE-ME-then-change-it-again-after-first-login"

# --- Web ------------------------------------------------------------------
# These two are also passed as Docker build args in docker-compose.prod.yml
# (Next.js NEXT_PUBLIC_* vars are baked in at build time, not read at
# runtime) — keep both copies in sync if you ever change the domain.
NEXT_PUBLIC_API_URL="https://api.yaseen.pk/api/v1"
NEXT_PUBLIC_SITE_URL="https://yaseen.pk"
