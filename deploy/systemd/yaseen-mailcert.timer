[Unit]
Description=Check daily whether mailcow needs Caddy's renewed mail certificate

[Timer]
OnCalendar=*-*-* 04:20:00
# A VPS that was off at 04:20 still syncs — an expired certificate on port 587
# stops the store sending mail entirely.
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
