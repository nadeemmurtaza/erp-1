// Phase 7 WO-7.6 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// Replaces the browser-only `localStorage` wishlist
// (`apps/web/src/lib/wishlist.ts`), which was tied to one browser, invisible
// to staff, and could not drive a back-in-stock alert. The API migrates
// whatever is in the browser on first sign-in (`POST /wishlist/migrate`) so a
// customer never silently loses what they saved.

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  /// Set when the customer saved a specific size/colour, not just the product.
  variantId String?
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId, createdAt])
  @@index([productId])
}

/// One row per customer waiting on one variant. A subscriber on
/// `DomainEvent.StockReplenished` (Phase 1's stock ledger) checks whether the
/// variant's total stock just crossed 0 → positive, notifies everyone
/// waiting, and deletes the requests — deleting on send is what makes a
/// flapping stock level (0 → 1 → 0 → 1) notify once per request rather than
/// repeatedly, since a re-request after the first alert creates a fresh row.
model BackInStockRequest {
  id        String   @id @default(cuid())
  userId    String
  variantId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, variantId])
  @@index([variantId])
}
