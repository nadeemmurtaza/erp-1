// Cart. Guest carts are keyed by an opaque token held in a cookie and merged
// into the account on login — a COD store cannot afford to force signup before
// checkout.

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int    @default(1)

  /// Set when the customer ticked "get it stitched" on unstitched fabric.
  /// stitchingServiceId points at a STITCHING_SERVICE product.
  stitchingServiceId   String?
  measurementProfileId String?
  stitchingNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart               Cart                      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product            Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  stitchingService   Product?                  @relation("CartItemStitchingService", fields: [stitchingServiceId], references: [id], onDelete: SetNull)
  measurementProfile MeasurementProfile?       @relation(fields: [measurementProfileId], references: [id], onDelete: SetNull)
  stitchingOptions   CartItemStitchingOption[]

  @@index([cartId])
}

model CartItemStitchingOption {
  cartItemId String
  optionId   String

  cartItem CartItem        @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option   StitchingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([cartItemId, optionId])
}
