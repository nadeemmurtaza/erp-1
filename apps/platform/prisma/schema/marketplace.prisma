// The cross-tenant marketplace/product-reference network — doc 165
// (165-cross-tenant-marketplace-directory.md) and doc 166
// (166-unified-product-reference-registry.md). Lives in this app's own
// control-plane database, never a tenant's, per
// 39-shared-cross-tenant-hosting-tier.md's "shared compute, never shared
// data" rule: what these tables hold is data a tenant explicitly chose to
// publish/share, categorically different from the private business data
// doc 39 protects.
//
// This file currently ships only doc 166's own registry plus the shared
// tenant credential doc 165 first named — MarketplaceListing/
// ViewerProfile/Engagement (doc 165's own discovery/transact layer) are not
// yet built; the credential below is deliberately named for the whole
// network, not just this registry, so doc 165 extends this same file and
// this same credential rather than issuing a second one per capability.

/// One row per tenant that has opted into the cross-tenant network (either
/// capability this file offers). Same "hash-only, shown once" discipline
/// as every other credential in this codebase — see
/// `agency-key.ts`/`AgencyApiKeyGuard` for the identical shape this
/// mirrors, with its own, separate pepper (`PLATFORM_MARKETPLACE_KEY_PEPPER`)
/// since this is a different credential type with a different blast
/// radius than the agency-managed-services key.
model MarketplacePublisherCredential {
  id         String    @id @default(cuid())
  tenantId   String    @unique
  apiKeyHash String    @unique
  rotatedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant PlatformTenant @relation(fields: [tenantId], references: [id])
}

enum ProductReferenceReviewStatus {
  UNREVIEWED
  CONFIRMED
  FLAGGED
}

/// One row per physical product, keyed by the one fact that is
/// unambiguously true regardless of who is selling it: its barcode. The
/// registering tenant is recorded for provenance and moderation authority
/// (see GlobalProductReferenceFlag), never for runtime ownership of every
/// future read — any tenant holding a MarketplacePublisherCredential may
/// look one up.
model GlobalProductReference {
  id                   String                       @id @default(cuid())
  /// The GTIN/UPC/EAN off the box. The one join key every participant in
  /// the chain already has, since it is already printed on the physical
  /// product — no new identifier scheme invented.
  barcode              String                       @unique
  registeredByTenantId String
  reviewStatus         ProductReferenceReviewStatus @default(UNREVIEWED)
  /// Every other descriptive "small detail" beyond name/description/care
  /// instructions/images — fabric, season, dimensions, weight, safety
  /// notes, whatever a sector pack cares about. A plain JSON bag, not a
  /// hardcoded column per attribute: MULTI-SECTOR.md's own "sector =
  /// configuration" rule means an apparel pack's keys (fabric, fit) and a
  /// grocery pack's keys (expiryMonths, storageTemp) must never force a
  /// schema change on this universal, sector-agnostic table.
  attributes           Json                         @default("{}")
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  registeredByTenant PlatformTenant                      @relation(fields: [registeredByTenantId], references: [id])
  translations       GlobalProductReferenceTranslation[]
  images             GlobalProductReferenceImage[]
  links              GlobalProductReferenceLink[]
  flags              GlobalProductReferenceFlag[]

  @@index([registeredByTenantId])
}

/// Mirrors ProductTranslation's own locale-keyed shape exactly (en/ur) —
/// the identical structure a linked tenant's own table is synced into.
model GlobalProductReferenceTranslation {
  id               String  @id @default(cuid())
  referenceId      String
  locale           String
  name             String
  description      String?
  careInstructions String?

  reference GlobalProductReference @relation(fields: [referenceId], references: [id])

  @@unique([referenceId, locale])
}

/// The shared image itself, stored once in the platform app's own storage
/// driver — never copied into a linking tenant's bucket for a
/// cloud-connected tenant (an offline-capable deployment's own local
/// snapshot is the one place this document's own bytes ARE duplicated,
/// deliberately — see doc 166's own "Where the real storage cost is").
/// altText is mandatory, unchanged from doc 03's own enforced-alt-text gate.
model GlobalProductReferenceImage {
  id          String @id @default(cuid())
  referenceId String
  url         String
  altText     String
  order       Int    @default(0)

  reference GlobalProductReference @relation(fields: [referenceId], references: [id])

  @@index([referenceId])
}

/// One row per tenant that has linked one of their own ProductVariants to
/// this shared reference. This is the join the push sync fan-out and the
/// pull/export endpoint both walk — never a live read path a storefront
/// touches per request.
model GlobalProductReferenceLink {
  id          String   @id @default(cuid())
  referenceId String
  tenantId    String
  /// The tenant's own ProductVariant.id — opaque here, exactly as
  /// MarketplaceListing.externalRef is opaque in doc 165.
  variantRef  String
  linkedAt    DateTime @default(now())

  reference GlobalProductReference @relation(fields: [referenceId], references: [id])
  tenant    PlatformTenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, variantRef])
  @@index([referenceId])
  @@index([tenantId])
}

/// A non-owning tenant's report that a shared reference is wrong —
/// reviewed by platform staff, never auto-applied. This is the toxic-pair
/// guard: without it, any tenant could silently rewrite another's
/// canonical record by editing "their own" reference.
model GlobalProductReferenceFlag {
  id                String    @id @default(cuid())
  referenceId       String
  flaggedByTenantId String
  reason            String
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  reference       GlobalProductReference @relation(fields: [referenceId], references: [id])
  flaggedByTenant PlatformTenant         @relation(fields: [flaggedByTenantId], references: [id])

  @@index([referenceId])
}
