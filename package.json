{
  "name": "yaseenecom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "node scripts/install-git-hooks.mjs && turbo run lint && node scripts/check-module-boundaries.mjs && node scripts/check-chart-imports.mjs && node scripts/check-frontend-secrets.mjs && node scripts/check-env-templates.mjs && node scripts/check-rebrand.mjs && node scripts/check-contrast.mjs && node scripts/check-links.mjs && node scripts/check-permission-checks.mjs && node scripts/check-rules.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "boundaries": "node scripts/check-module-boundaries.mjs",
    "check:secrets": "node scripts/check-frontend-secrets.mjs",
    "check:env": "node scripts/check-env-templates.mjs",
    "check:rebrand": "node scripts/check-rebrand.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:rules": "node scripts/check-rules.mjs",
    "check:email": "node scripts/check-email-dns.mjs",
    "index": "node scripts/build-index.mjs",
    "index:check": "node scripts/build-index.mjs --check",
    "idx": "node scripts/idx.mjs",
    "check": "node scripts/check.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "db:migrate": "pnpm --filter @newax/api db:migrate",
    "db:generate": "pnpm --filter @newax/api db:generate",
    "db:seed": "turbo run db:seed",
    "db:reset": "pnpm --filter @newax/api db:reset",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "ts-morph": "^28.0.0",
    "turbo": "2.10.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.23",
      "deepmerge-ts": ">=8.0.0",
      "js-yaml": ">=5.2.2",
      "@smithy/core": "3.33.3"
    }
  }
}
