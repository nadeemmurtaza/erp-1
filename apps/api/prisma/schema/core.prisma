// Core: identity, addresses, runtime settings, audit trail and the event outbox.
// Every other module may reference these; they reference no module.

enum UserRole {
  CUSTOMER
  STAFF
  TAILOR
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique // normalised E.164
  passwordHash String?
  firstName    String?
  lastName     String?
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses           Address[]
  refreshTokens       RefreshToken[]
  measurementProfiles MeasurementProfile[]
  carts               Cart[]
  orders              Order[]
  stitchingOrders     StitchingOrder[]
  tailorProfile       TailorProfile?
  assignedJobs        StitchingJob[]       @relation("JobTailor")
  jobEvents           StitchingJobEvent[]
  orderStatusEvents   OrderStatusEvent[]
  auditLogs           AuditLog[]
  contact             Contact?             @relation("ContactUser")
  ownedContacts       Contact[]            @relation("ContactOwner")
  ownedLeads          Lead[]               @relation("LeadOwner")
  interactions        Interaction[]
  assignedFollowUps   FollowUpTask[]       @relation("FollowUpAssignee")
  approvedPayments    Payment[]            @relation("PaymentApprover")
  segments            Segment[]
  devices             DeviceToken[]

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String?
  label      String? // "Home", "Office"
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  province   String
  postalCode String?
  country    String   @default("PK")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Runtime configuration edited from the admin dashboard: store name, shipping
/// zones, COD fee, stitching lead times. Business rules are data, not constants.
model Setting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // "product.updated", "order.status_changed"
  entity    String // "Product", "Order"
  entityId  String?
  data      Json?
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Transactional outbox. Domain events are written in the same transaction as
/// the state change that produced them, then dispatched to subscribers by a
/// background worker — so a failing subscriber retries instead of losing the
/// event, and never blocks checkout.
model OutboxEvent {
  id          String       @id @default(cuid())
  name        String // "order.placed"
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  availableAt DateTime     @default(now())
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([name])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// A push notification target: one installation of the mobile app.
///
/// Keyed on the token itself, because reinstalling the app or restoring a
/// backup can hand the same token to a different account — registering simply
/// moves it, rather than leaving the old owner receiving someone else's
/// garments.
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform @default(ANDROID)
  appVersion String?
  locale     String?
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
