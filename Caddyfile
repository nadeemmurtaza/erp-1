# Reverse proxy for yaseen.pk. Caddy issues/renews Let's Encrypt certs for
# each domain automatically — no manual cert setup needed, just DNS A/AAAA
# records pointing every hostname below at the VPS (see DEPLOYMENT.md).
#
# Runs in docker-compose.caddy.yml, on the yaseen-edge network shared by
# docker-compose.prod.yml and docker-compose.staging.yml — container names
# below (yaseen-web-prod, etc.) resolve via Docker's embedded DNS on that
# network.

# --- Production -------------------------------------------------------

www.yaseen.pk {
	redir https://yaseen.pk{uri} permanent
}

yaseen.pk {
	# Admin lives at /admin on this same app (apps/web) — not a separate
	# container or subdomain, per how the storefront/admin app is built.
	reverse_proxy yaseen-web-prod:3000
	encode zstd gzip
	log {
		output file /data/access-yaseen.pk.log
	}
}

api.yaseen.pk {
	reverse_proxy yaseen-api-prod:3001
	encode zstd gzip
	log {
		output file /data/access-api.yaseen.pk.log
	}
}

# --- Mail (Stalwart) --------------------------------------------------
#
# Caddy owns 80/443, so Stalwart's own ACME client cannot complete a challenge
# and is left off. Caddy fronts its admin UI here and, as a side effect, holds
# the certificate for mail.yaseen.pk — which deploy/mail/sync-certs.sh then
# copies to Stalwart, since it serves SMTP and IMAP on 25/465/587/993 itself
# and needs the certificate on disk.
#
# The container joins yaseen-edge (docker-compose.mail.yml), so it resolves by
# name here with nothing published on 80/443. See docs/email.md.
#
# Do not add this block before the mail container exists: mail.yaseen.pk
# already resolves, so Caddy would take out a certificate and then 502.

mail.yaseen.pk {
	reverse_proxy yaseen-stalwart:8080
	encode zstd gzip
	log {
		output file /data/access-mail.yaseen.pk.log
	}
}

# Mail clients look these up to configure themselves. Without them, adding the
# account to a phone means typing server names in by hand.
autodiscover.yaseen.pk, autoconfig.yaseen.pk {
	reverse_proxy yaseen-stalwart:8080
	encode zstd gzip
}

# --- Staging (auto-deployed from `main`) ------------------------------

test.yaseen.pk {
	reverse_proxy yaseen-web-staging:3000
	encode zstd gzip
	log {
		output file /data/access-test.yaseen.pk.log
	}
}

api-test.yaseen.pk {
	reverse_proxy yaseen-api-staging:3001
	encode zstd gzip
	log {
		output file /data/access-api-test.yaseen.pk.log
	}
}
