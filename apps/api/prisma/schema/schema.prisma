// Datasource and generator only. Models live in one file per module —
// see core.prisma, catalog.prisma, measurements.prisma, and so on.
//
// Adding a module means adding a .prisma file in this folder; nothing here
// needs to change.

generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/prisma"
  // "native" covers local dev on whatever OS you're on; the musl target is
  // for the Alpine-based Docker image — listing both means `prisma generate`
  // produces an engine that runs correctly in both places from one schema.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
