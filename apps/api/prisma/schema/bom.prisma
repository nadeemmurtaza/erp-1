// BOM: which raw materials go into a finished product, how much of each, and
// what that makes the product cost to produce (RETAIL-ERP.md Tranche 6,
// WO-23.2 — "build 10-admin-dashboard.md §C as written"). WO-C.1 added
// RawMaterial; this file now also carries WO-C.2's BomRecipe/BomComponent.
// Production runs (BomProductionRun/BomProductionLine, WO-C.3) are the next
// work order in the same tranche — BomRecipe.runs and
// RawMaterial.productionLines back-relations are added then, not stubbed in
// now (no model to point at yet).
//
// A raw material is NOT a new kind of thing. It is an ordinary ProductVariant
// with a RawMaterial marker row pointing at it, so purchase orders, goods
// receipts, the stock ledger, stock counts, reorder points and weighted-average
// costing all work on fabric exactly as they work on a kurta (D5) — this file
// adds no coupling to inventory/purchasing at all; every one of those already
// works on any ProductVariant.
//
// QUANTITIES ARE INTEGER BASE UNITS, the same discipline money uses. unitScale
// says how many base units make one display unit: fabric is GAZ with unitScale
// 1000, so stock 12500 is 12.5 gaz and costPrice is paisa per milli-gaz.
// Convert only at the UI boundary, through @newax/shared's toBaseUnits /
// fromBaseUnits / formatQuantity. A bare scale multiplication in a component
// is a bug.

enum RawMaterialUnit {
  GAZ
  METRE
  PIECE
  SPOOL
  GRAM
  MILLILITRE
}

model RawMaterial {
  id String @id @default(cuid())

  /// The ProductVariant that carries stock, costPrice, supplier links and the
  /// movement ledger. One variant is at most one raw material.
  variantId String @unique

  /// Staff-only. Not a translation row (Rule 6, D10): nobody shopping sees this.
  name String
  /// "fabric" | "trim" | "packaging" | "consumable". Groups the raw-usage report.
  kind String @default("fabric")

  unit RawMaterialUnit
  /// Base units per display unit. 1000 for continuous goods, 1 for countable.
  /// Effectively immutable once stock or a StockMovement exists for the
  /// variant — see raw-material.service.ts's own note on why.
  unitScale Int @default(1)

  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Recipes that consume this material. Restrict delete (BomComponent's own
  /// FK): a raw material a live recipe depends on cannot vanish out from
  /// under it.
  components BomComponent[]

  @@index([isActive, kind])
  @@index([name])
}

enum BomStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The recipe for one finished ProductVariant: which raw materials, how much
/// of each, and the resulting cost estimate. WO-C.2 (10-admin-dashboard.md
/// §C). No nesting in v1 — recipe.service.ts refuses a BomComponent whose
/// raw material's own variant carries a BomRecipe, and a component pointing
/// at the recipe's own output variant. Sub-assemblies are explicitly
/// deferred (they turn a two-day work order into a two-week one).
model BomRecipe {
  id String @id @default(cuid())

  /// The finished ProductVariant this recipe produces. One live recipe per variant.
  variantId String @unique

  status  BomStatus @default(DRAFT)
  version Int       @default(1)

  /// How many finished units one run yields. Lets a recipe be written
  /// per-dozen where that is how the workshop actually thinks.
  outputQuantity Int @default(1)

  /// Expected scrap, basis points (Rule 5). 500 = 5%. Per-component override wins.
  wastageBps Int @default(0)

  /// Paisa per finished unit. Not materials — stitching labour and overhead.
  labourCost   Int @default(0)
  overheadCost Int @default(0)

  /// CACHE. Paisa per finished unit at CURRENT raw costs (cost-rollup.ts).
  /// Recomputed on every recipe edit and every goods receipt touching a
  /// component (bom.listener.ts). An ESTIMATE for the editor — it is NEVER
  /// the COGS of a sale, which is OrderItem.unitCost (Rule 7).
  rolledUpUnitCost Int       @default(0)
  /// False when any non-optional component's variant.costPrice is 0
  /// (UNKNOWN, not free) — surfaced, never silently treated as free.
  costComplete     Boolean   @default(false)
  costComputedAt   DateTime?

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdBy  User?          @relation("BomRecipeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  components BomComponent[]

  @@index([status])
  @@index([costComplete])
}

model BomComponent {
  id            String @id @default(cuid())
  recipeId      String
  rawMaterialId String

  /// BASE units of the raw material consumed per outputQuantity finished units.
  quantityBase Int
  /// Overrides BomRecipe.wastageBps for this line. Null = inherit.
  wastageBps   Int?
  isOptional   Boolean @default(false)
  note         String?
  order        Int     @default(0)

  recipe      BomRecipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([recipeId, rawMaterialId])
  @@index([rawMaterialId])
}
