model Supplier {
  id              String   @id @default(cuid())
  name            String
  contactName     String?
  phone           String?
  email           String?
  address         String?
  city            String?
  /// ISO 3166-1 alpha-2, e.g. "PK", "CN". Null for a domestic supplier whose
  /// country was never recorded before this field existed (RETAIL-ERP.md R16).
  country         String?
  /// ISO 4217 — the currency their bills are raised in. Defaults to the
  /// deployment's own base currency; only an international supplier's bills
  /// actually carry FX (see SupplierBill.fxRateScaled).
  currency        String   @default("PKR")
  /// Their tax registration number — NTN, TRN, VAT id, whatever the
  /// jurisdiction calls it. Free text: the label is locale policy, not a
  /// column (see brand.ts), and a supplier's own paperwork is what the
  /// bookkeeper reads regardless of what we'd call it.
  taxId           String?
  /// Free text: "FOB Shanghai", "DDP", "EXW" — customs/shipping terms for an
  /// international supplier. Display-only today, no INCOTERMS enum.
  incoterms       String?
  /// True marks a supplier whose bills need the FX posting rules (WO-19.3) —
  /// distinct from `currency !== base`, since a shop may quote a domestic
  /// supplier in USD without customs/duty being involved at all.
  isInternational Boolean  @default(false)
  /// Free text: "30 days net", "advance", "on delivery".
  paymentTerms    String?
  /// Typical days from order to delivery. Feeds reorder suggestions.
  leadTimeDays    Int      @default(7)
  notes           String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// The permanent counterparty profile this Supplier is the SUPPLIER-role
  /// extension of (parties.prisma). Nullable during the expand phase of an
  /// expand/contract rollout: a backfill script (prisma/backfill-parties.ts)
  /// creates one Party per pre-existing Supplier row; every Supplier created
  /// from here on gets one transactionally (see PurchasingService.create()).
  /// name/contactName/phone/email/address/city above stay in place — reading
  /// exclusively through party and dropping them is a deliberate follow-up,
  /// not part of this change.
  partyId          String? @unique
  party            Party?  @relation(fields: [partyId], references: [id], onDelete: SetNull)
  /// Null (the default) means manual entry, exactly as before this field
  /// existed. Set it to feed this supplier's bills in automatically once
  /// they're a connected TradingPartner (18-trading-partner-network.md,
  /// WO-18.2) — trading-partners is a togglable pack and purchasing must
  /// never import it, so this is a bare scalar FK, not a cross-module
  /// service call.
  tradingPartnerId String?

  products SupplierProduct[]
  expenses Expense[]
  // Note: purchaseOrders and bills are for WO-1.5, not included yet.

  tradingPartner    TradingPartner?  @relation(fields: [tradingPartnerId], references: [id], onDelete: SetNull)
  preferredVariants ProductVariant[] @relation("PreferredSupplier")
  purchaseOrders    PurchaseOrder[]
  supplierBills     SupplierBill[]

  @@index([isActive, name])
  @@index([tradingPartnerId])
}

/// What a given supplier charges for a given variant, and under what terms.
model SupplierProduct {
  id           String  @id @default(cuid())
  supplierId   String
  variantId    String
  /// The supplier's own code for it, for the PO they will read.
  supplierSku  String?
  /// Last agreed unit cost in paisa. Pre-fills a new PO line.
  lastCost     Int     @default(0)
  /// Minimum order quantity this supplier accepts.
  moq          Int     @default(1)
  leadTimeDays Int?
  isPreferred  Boolean @default(false)

  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([supplierId, variantId])
  @@index([variantId, isPreferred])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  number     String              @unique
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  currency   String              @default("PKR")

  subtotal    Int @default(0)
  freightCost Int @default(0)
  dutyCost    Int @default(0)
  otherCost   Int @default(0)
  total       Int @default(0)

  expectedAt  DateTime?
  sentAt      DateTime?
  receivedAt  DateTime?
  cancelledAt DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]
  bills     SupplierBill[]

  @@index([status, createdAt])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Int
  lineTotal        Int
  note             String?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id])
  receiptItems  GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  number          String   @unique
  purchaseOrderId String
  receivedAt      DateTime @default(now())
  receivedById    String?
  notes           String?
  freightCost     Int      @default(0)
  dutyCost        Int      @default(0)
  otherCost       Int      @default(0)
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User?              @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
}

model GoodsReceiptItem {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  variantId           String
  quantity            Int
  unitCost            Int
  landedUnitCost      Int

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  variant           ProductVariant    @relation(fields: [variantId], references: [id])

  @@index([goodsReceiptId])
  @@index([variantId])
}

enum SupplierBillStatus {
  UNPAID
  PARTIAL
  PAID
}

model SupplierBill {
  id              String             @id @default(cuid())
  supplierId      String
  purchaseOrderId String?
  reference       String?
  /// In `currency` below — the supplier's own invoiced amount, not
  /// necessarily the base currency (RETAIL-ERP.md R16).
  amount          Int
  /// Cumulative, in `currency` below — the same unit as `amount`, so
  /// "amount - amountPaid" is always the outstanding balance in the bill's
  /// own currency without a conversion.
  amountPaid      Int                @default(0)
  /// ISO 4217. Defaults to the deployment's own base currency; set from the
  /// supplier's own `currency` when raised.
  currency        String             @default("PKR")
  /// rate * 1_000_000 (House Rule 5 / R16) at the moment this bill was
  /// raised — the "booked" rate a later payment's settlement rate is
  /// compared against to post a realised FX gain/loss. 1_000_000 for a
  /// base-currency bill; never re-derived once set (House Rule 7).
  fxRateScaled    Int                @default(1000000)
  /// `amount` converted to the base currency at `fxRateScaled`, computed
  /// once at creation (`convertToBase`, @newax/shared) — what actually
  /// posts to Accounts Payable (posting-rules.subscriber.ts).
  baseAmountMinor Int
  status          SupplierBillStatus @default(UNPAID)
  issuedAt        DateTime           @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([supplierId, status])
  @@index([status, dueAt])
}
