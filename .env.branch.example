# ---------------------------------------------------------------------------
# Branch box secrets for docker-compose.branch.yml (WO-20.5, RETAIL-ERP.md
# Part 6). Runs on the branch's own machine, never internet-facing — see
# docker-compose.branch.yml's own header for why.
#
# On the branch's machine: cp .env.branch.example .env.branch, then fill in
# every value below for real. Used the same two ways .env.production.example
# is (see its own header) — DATABASE_URL is likewise built by
# docker-compose.branch.yml itself, not listed here. Never commit .env.branch.
#
# What this omits, and why: JazzCash/Easypaisa/nID are online-checkout and
# storefront concerns this box does not run (its till is apps/pos, a later
# work order) — copy them from .env.production.example if this branch ever
# also serves the public site directly, which is not the common case.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database (used to build DATABASE_URL — see docker-compose.branch.yml) -
POSTGRES_USER=yaseen
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-base64-32
POSTGRES_DB=yaseen

# --- API --------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
# LAN origins only — this box is not internet-facing. Add the branch's own
# LAN hostname/IP if staff reach the web admin by something other than
# localhost (a shared office PC visiting http://till-1.local:3000, say).
CORS_ORIGINS="http://localhost:3000"

# --- Auth ---------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE-ME"
JWT_REFRESH_SECRET="CHANGE-ME"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Exactly 32 bytes. Generate with: openssl rand -base64 24 | head -c 32
APP_ENCRYPTION_KEY="CHANGE-ME-32-BYTES-EXACTLY-PLZ!!"

# --- Topology (RETAIL-ERP.md) ---------------------------------------------
# This is what makes it a BRANCH, not a STANDALONE shop: it replicates to a
# BRAND parent (WO-20.2's node auth + sync agent) instead of running alone.
# NODE_ID must be unique across the whole chain (R6) — "lhr-01", not "main".
NODE_ROLE=BRANCH
NODE_ID=CHANGE-ME-e.g-lhr-01
# The BRAND deployment this branch reports to.
PARENT_URL=CHANGE-ME-https://brand1.example
# Issued by the parent: POST /api/v1/organization/nodes (register this
# branch there first), then POST /api/v1/organization/nodes/:nodeId/rotate-inbound-key
# — the raw key that call returns, shown once, goes here.
PARENT_API_KEY=CHANGE-ME-node_...

# --- Module registry ------------------------------------------------------
# The same allowlist mechanism every deployment uses (CLAUDE.md's Sector
# axis) — trim to what this branch's own business actually needs.
#
# This template trims DELIBERATELY: marketing, analytics, reports, finance,
# tradingpartners, promotions and giftcards are hub concerns a branch node
# reports INTO rather than runs itself, so they stay off here while being on
# in .env.example. The `# Available:` line is what keeps that a choice rather
# than an omission — scripts/check-env-templates.mjs requires every
# registered module to appear on it, so a trim is always visible to whoever
# copies this file.
# Available: catalog,measurements,cart,stitching,inventory,purchasing,production,bom,parties,tradingpartners,payments,orders,crm,marketing,analytics,reports,tax,finance,fulfilment,payroll,hr,tracking,promotions,giftcards,content,collections,search,onsitemessages,reviews,wishlist,loyalty,notification-preferences,recommendations,receivables,organization,accounting,identity-verification,pos,transfers,wallet,settlements,managed-services
# Off by default everywhere, deliberately (modules.registry.ts marks each
# offByDefault) — a Solo shop must not see a chain or GL concept at all,
# RETAIL-ERP.md R14. Add one to MODULES only once the deployment really has
# branches, a general ledger, a physical till, or NID credentials:
#   organization, accounting, identity-verification, pos, transfers
MODULES="catalog,measurements,cart,orders,payments,stitching,inventory,purchasing,production,bom,parties,crm,tax,fulfilment,tracking"

# --- Payments -------------------------------------------------------------
# In-branch tender only, until apps/pos (WO-21.x) exists to take a card
# terminal or wallet payment at the till.
PAYMENT_PROVIDERS="cod,bank_transfer"
COURIER_PROVIDERS="manual"

# --- Storage ----------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR="./uploads"
LOCAL_STORAGE_PUBLIC_URL="http://localhost:3001/api/v1/files"

# --- Notifications ------------------------------------------------------
NOTIFICATION_CHANNELS="log"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Yaseen <no-reply@yaseen.pk>"

# --- Seed admin (only used the first time the DB is seeded) ---------------
SEED_ADMIN_EMAIL="admin@yaseen.pk"
SEED_ADMIN_PASSWORD="CHANGE-ME-then-change-it-again-after-first-login"

# --- Web ------------------------------------------------------------------
# Also passed as Docker build args in docker-compose.branch.yml (Next.js
# NEXT_PUBLIC_* vars are baked in at build time) — keep both copies in sync.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
