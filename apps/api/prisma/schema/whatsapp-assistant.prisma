// WO-9.7, docs/implementation/ai-layer/09-ai-layer.md.
//
// The assistant's own conversation log, kept separately from crm.prisma's
// generic Interaction — a WhatsApp exchange is a back-and-forth of
// individually AI-or-human-attributed messages, not a single logged event,
// and `WhatsAppMessage.aiGenerated` is exactly the fact an incident review
// needs first ("did the bot say that, or did a person?"). Every
// conversation still resolves to a Contact (crm.prisma) — see that model's
// own `whatsAppConversations` relation — so it shows up on the customer's
// own timeline alongside everything else, never as an island.

/// Set once identity is verified (the inbound phone number matches this
/// Contact's own phoneE164 — WhatsAppAssistantService's own non-negotiable,
/// never relaxed) and cleared to true the moment any message in it needs a
/// human: a complaint, a refund amount, a payment problem, or the customer
/// asking outright. The assistant never replies again in a handed-off
/// conversation; only a staff reply (through the existing CRM inbox
/// pattern) does.
model WhatsAppConversation {
  id               String    @id @default(cuid())
  contactId        String
  phoneE164        String
  startedAt        DateTime  @default(now())
  lastMessageAt    DateTime  @default(now())
  handedOffToHuman Boolean   @default(false)
  handoffReason    String?
  handedOffAt      DateTime?

  contact  Contact              @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages WhatsAppMessage[]

  @@index([contactId, lastMessageAt])
  @@index([phoneE164])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppMessage {
  id             String                   @id @default(cuid())
  conversationId String
  direction      WhatsAppMessageDirection
  body           String
  /// True only for an OUTBOUND message the AiProvider actually generated —
  /// false for the handoff notice, an AUTO_CONFIRM/CONFIRMATION_CALL system
  /// reply, or anything a staff member typed.
  aiGenerated    Boolean                  @default(false)
  createdAt      DateTime                 @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
