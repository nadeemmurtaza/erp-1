# ---------------------------------------------------------------------------
# Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database -------------------------------------------------------------
# connection_limit/pool_timeout: Prisma's default pool size is derived from
# the machine's CPU count, which is fine on a real workstation but can be as
# low as 3 on a small VM or CI runner — too few for the e2e suite's
# concurrency tests (several simultaneous checkouts/bookings, each holding a
# connection for its transaction) without them queuing and timing out.
# Matches docker-compose.prod.yml's DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yaseen?schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10"

# --- API ------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0000000000"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-000000000"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Exactly 32 bytes. Generate with: openssl rand -base64 24 | head -c 32
APP_ENCRYPTION_KEY="dev-app-encryption-key-32-bytes0"

# --- Topology (RETAIL-ERP.md) ---------------------------------------------
# STANDALONE = this deployment today: one node, no replication, every chain
# concept invisible. BRANCH and BRAND replicate to PARENT_URL; ORG has none.
NODE_ROLE=STANDALONE
NODE_ID=main
# PARENT_URL=https://brand1.example

# --- Module registry ------------------------------------------------------
# Comma-separated allowlist of optional modules. Core modules are always on.
# `# Available:` below is checked by scripts/check-env-templates.mjs: every
# registered module must appear there, so nothing can go missing from this
# template without the build noticing.
# Available: catalog,measurements,cart,stitching,inventory,purchasing,production,parties,tradingpartners,payments,orders,crm,marketing,analytics,reports,tax,tracking,content,collections,search,onsitemessages,organization,accounting,identity-verification,pos,transfers,wallet,settlements,managed-services
# Off by default everywhere, deliberately (modules.registry.ts marks each
# offByDefault) — a Solo shop must not see a chain or GL concept at all,
# RETAIL-ERP.md R14. Add one to MODULES only once the deployment really has
# branches, a general ledger, a physical till, or NID credentials:
#   organization, accounting, identity-verification, pos, transfers
# `managed-services` is different from the other five: it is never added
# here by hand at all. It is requested through the Extractor
# (`scripts/sync-client.mjs --modules=...,managed-services`) for an
# agency-managed delivery ONLY — see the AGENCY_API_URL block below.
MODULES="catalog,measurements,cart,orders,payments,stitching,inventory,purchasing,production,bom,parties,tradingpartners,crm,marketing,analytics,reports,tax,finance,fulfilment,payroll,hr,orgstructure,tracking,promotions,giftcards,content,collections,search,onsitemessages,reviews,wishlist,loyalty,notification-preferences,recommendations,receivables,rag"

# --- Payments -------------------------------------------------------------
# Comma-separated allowlist of enabled payment providers.
# Available: cod,bank_transfer,jazzcash,easypaisa
PAYMENT_PROVIDERS="cod,bank_transfer"
COURIER_PROVIDERS="manual"

# JazzCash (leave blank until the merchant account is approved)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL="http://localhost:3000/checkout/callback/jazzcash"
JAZZCASH_SANDBOX=true

# Easypaisa (leave blank until the merchant account is approved)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL="http://localhost:3000/checkout/callback/easypaisa"
EASYPAISA_SANDBOX=true

# Giftkarta — third-party gift-card redemption at checkout (leave blank until
# a real API reference confirms these field names; see giftkarta.provider.ts)
GIFTKARTA_API_BASE_URL=
GIFTKARTA_API_KEY=

# nID identity verification (github.com/nadeemmurtaza/nID) — leave blank until
# this shop's tenant account and API key exist there. Also add
# 'identity-verification' to MODULES above once these are set.
NID_API_URL=
NID_API_KEY=
NID_WEBHOOK_SECRET=

# Managed services (agency-hosted billing dashboard) — leave blank for a
# self-hosted deployment. AGENCY_API_URL is the agency's own Master
# Platform base URL; AGENCY_API_KEY is generated fresh per client by the
# Extractor and appended here automatically, never committed to this
# template. Also add 'managed-services' to MODULES above once both are set
# — see docs/implementation/commercial-licensing-agency/14-managed-services-module.md.
AGENCY_API_URL=

# --- Storage (S3-compatible; MinIO locally) -------------------------------
STORAGE_DRIVER=local
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_BUCKET=yaseen
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9000/yaseen"
LOCAL_STORAGE_DIR="./uploads"
LOCAL_STORAGE_PUBLIC_URL="http://localhost:3001/api/v1/files"

# --- Notifications --------------------------------------------------------
# Channels: log (dev), expo_push (mobile app), email, whatsapp, sms
# Leave this as "log" in development: every email the store would send is
# printed to the API log instead, so no mail server is needed to work on it.
NOTIFICATION_CHANNELS="log"

# --- Email ----------------------------------------------------------------
# Adding "email" above without an SMTP_HOST stops the API booting, rather than
# silently dropping order confirmations.
# SMTP — works with any relay: Stalwart, Cloudflare, SES, Resend, etc.
# Stalwart:   host=<vps-ip>, port=587, secure=false, user=<stalwart-email>
# Cloudflare: host=smtp.mx.cloudflare.net, port=465, secure=true, user=api_token
SMTP_HOST=
SMTP_PORT=587
# true only for implicit TLS on port 465; 587 upgrades via STARTTLS.
SMTP_SECURE=false
# A dedicated mailbox created in the Stalwart admin UI, not an admin account.
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Yaseen <no-reply@yaseen.pk>"
# Customers do reply to order mail. Point this at a mailbox someone reads.
MAIL_REPLY_TO="hello@yaseen.pk"

# --- WhatsApp / SMS (WO-8.4) ------------------------------------------------
# Adding "whatsapp"/"sms" above without these stops the API booting. A
# generic gateway contract (POSTs {from, to, message} as JSON, bearer token)
# — leave blank until a real provider reference confirms these field names,
# same reasoning as GIFTKARTA_* below.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_FROM_NUMBER=
# Verifies inbound WhatsApp webhooks (WO-9.7) — without it every inbound
# message is rejected unverified, never waved through.
WHATSAPP_WEBHOOK_SECRET=
SMS_API_URL=
SMS_API_TOKEN=
SMS_FROM_NUMBER=

STORE_NAME="Yaseen"
# Builds the "View your order" links. Must be the public storefront origin.
STOREFRONT_URL="http://localhost:3000"
# Shown in bank-transfer emails, so the customer knows where to send proof.
SUPPORT_WHATSAPP=
# Free text, newline-separated — printed as-is in the bank transfer panel.
BANK_TRANSFER_DETAILS=

# --- Seed admin (development only) ---------------------------------------
SEED_ADMIN_EMAIL="admin@yaseen.pk"
SEED_ADMIN_PASSWORD="admin12345"

# --- Web ------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Platform control plane (apps/platform, 39-shared-cross-tenant-hosting-tier.md) ---
# Its own, separate database — never a tenant's. Deliberately PLATFORM_-
# prefixed so it can never be confused with the tenant DATABASE_URL above,
# even when both are loaded from this same file (see DECISIONS.md's entry
# on shared-infrastructure/isolated-data).
PLATFORM_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newax_platform?schema=public"
# A connection with CREATEDB privilege — used ONLY to create/drop a
# tenant's own isolated database. Separate blast radius from the URL above.
PLATFORM_PROVISIONING_ADMIN_URL="postgresql://postgres:postgres@localhost:5432/postgres"
# Exactly 32 bytes. Generate with: openssl rand -base64 24 | head -c 32
PLATFORM_ENCRYPTION_KEY="dev-platform-encryption-key-32by"
# At least 32 characters. Mixed into every PlatformOpsClient key hash.
PLATFORM_OPS_KEY_PEPPER="dev-platform-ops-key-pepper-at-least-32-chars"
PLATFORM_API_PORT=3100
PLATFORM_API_PREFIX=platform
