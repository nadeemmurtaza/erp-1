[Unit]
Description=Copy Caddy's mail certificate to Stalwart and restart it if it changed
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/yaseenecom
# Override if the mail hostname or the compose project name differs.
# Environment=MAIL_HOST=mail.yaseen.pk
# Environment=CERT_VOLUME=yaseenecom_mail-certs
ExecStart=/home/deploy/apps/yaseenecom/deploy/mail/sync-certs.sh
TimeoutStartSec=600
