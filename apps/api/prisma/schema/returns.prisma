// Phase 7 WO-7.3 (docs/implementation/customer-portal-loyalty/07-customer-portal.md).
//
// Scoped deliberately narrow. Phase 6's own brief
// (docs/implementation/shipping-fulfilment-returns/06-shipping-fulfilment-returns.md)
// is unbuilt — no courier integration, no return shipping label, no
// inspection/restocking workflow, no RTO tracking — and this phase does not
// build it. What WO-7.3 actually asks for is the customer-facing half: a
// real request a customer can submit and track honestly, and a staff
// approve/reject decision. Approving a return does not move money on its
// own — a staff member finishes the refund through the existing
// `PaymentsService.refund()` (Phase 4) exactly as they would for any other
// refund, then marks this row REFUNDED so the customer sees it close out.
// Restocking the returned stock is a manual `InventoryService.move()` today,
// the same as it is for any other stock correction — Phase 6 is where that
// becomes automatic.
//
// Reason codes are a fixed enum, not an admin-editable table: the brief's
// "seeded list" is read here as a fixed list this phase seeds, not a second
// settings screen for six rows nobody has asked to edit yet.

enum ReturnReasonCode {
  DEFECTIVE
  WRONG_ITEM
  DAMAGED_IN_TRANSIT
  SIZE_FIT_ISSUE
  CHANGED_MIND
  OTHER
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  /// Staff's own confirmation that the refund was actually completed
  /// (`PaymentsService.refund()`), not a status this model sets itself.
  REFUNDED
}

model ReturnRequest {
  id      String @id @default(cuid())
  orderId String
  userId  String

  reasonCode ReturnReasonCode
  /// The customer's own free-text description of the problem.
  note       String?
  photoUrls  String[]            @default([])
  status     ReturnRequestStatus @default(REQUESTED)

  decidedAt       DateTime?
  decidedByUserId String?
  /// Shown to the customer verbatim — "rejected, no reason given" is a dead
  /// end (`.claude/rules/ui.md`'s own rule), so this is required on reject.
  decisionNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?               @relation("ReturnRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  lines     ReturnRequestLine[]

  @@index([orderId])
  @@index([userId, createdAt])
  @@index([status])
}

model ReturnRequestLine {
  id              String @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
}
