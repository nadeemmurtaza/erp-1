# ---------------------------------------------------------------------------
# Staging secrets for docker-compose.staging.yml â€” auto-deployed from `main`.
#
# On the VPS: cp .env.staging.example .env.staging, then fill in every value
# below. Same dual role as .env.production.example (see its header comment).
# Use DIFFERENT secrets from production here â€” staging is a lower-trust
# environment (e.g. reachable before code is reviewed for production) and
# its DB/Redis are already fully isolated by docker-compose.staging.yml, but
# sharing JWT secrets or the seed admin password with prod would let a
# staging compromise reach production sessions/tokens.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database (used to build DATABASE_URL â€” see docker-compose.staging.yml)
POSTGRES_USER=yaseen
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-base64-32
POSTGRES_DB=yaseen

# --- API --------------------------------------------------------------
API_PORT=3001
API_PREFIX=api
CORS_ORIGINS="https://test.yaseen.pk"

# --- Auth ---------------------------------------------------------------
# Generate each with: openssl rand -base64 48 â€” do NOT reuse the production
# secrets here.
JWT_ACCESS_SECRET="CHANGE-ME"
JWT_REFRESH_SECRET="CHANGE-ME"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Module registry ------------------------------------------------------
MODULES="catalog,measurements,cart,orders,payments,stitching,inventory,purchasing,crm,analytics,reports,tracking"

# --- Payments -------------------------------------------------------------
# Sandbox/test credentials only â€” staging should never touch real money.
PAYMENT_PROVIDERS="cod,bank_transfer"

JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL="https://test.yaseen.pk/checkout/callback/jazzcash"
JAZZCASH_SANDBOX=true

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL="https://test.yaseen.pk/checkout/callback/easypaisa"
EASYPAISA_SANDBOX=true

# --- Storage ----------------------------------------------------------
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=
LOCAL_STORAGE_DIR="./uploads"
LOCAL_STORAGE_PUBLIC_URL="https://api-test.yaseen.pk/api/v1/files"

# --- Notifications ------------------------------------------------------
NOTIFICATION_CHANNELS="log"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Yaseen Staging <no-reply@yaseen.pk>"

# --- Seed admin (only used the first time the DB is seeded) ---------------
SEED_ADMIN_EMAIL="admin@yaseen.pk"
SEED_ADMIN_PASSWORD="CHANGE-ME"

# --- Web ------------------------------------------------------------------
# These two are also passed as Docker build args in docker-compose.staging.yml
# (Next.js NEXT_PUBLIC_* vars are baked in at build time, not read at
# runtime) â€” keep both copies in sync if you ever change the domain.
NEXT_PUBLIC_API_URL="https://api-test.yaseen.pk/api/v1"
NEXT_PUBLIC_SITE_URL="https://test.yaseen.pk"
